// Let face-guard.service (User=geka) apply a Wi-Fi profile from a provisioning QR.
//
// The stock /usr/share/polkit-1/rules.d/org.freedesktop.NetworkManager.rules
// grants these actions only to subjects with `subject.local && subject.active`,
// i.e. a real logind session on a seat. A systemd system service has no logind
// session, so it falls through to the action default (auth_admin_keep) and
// nmcli fails with "Insufficient privileges" -- even though geka is in sudo and
// netdev. Running interactively works for the same reason it fails as a service.
//
// Scoped narrowly on purpose: one user, and only the actions provisioning/network.py
// needs -- connection add/modify (settings.modify.system) and connection up/down
// (network-control).

polkit.addRule(function (action, subject) {
    if (subject.user !== "geka") {
        return null;
    }
    if (action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
        action.id == "org.freedesktop.NetworkManager.network-control" ||
        action.id == "org.freedesktop.NetworkManager.enable-disable-wifi") {
        return polkit.Result.YES;
    }
});
